{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "optilens-local",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "foreach ($n in 'OPTILENS_DB_SERVER','OPTILENS_DB_NAME','OPTILENS_DB_USER','OPTILENS_DB_PASSWORD','OPTILENS_DB_ENCRYPT','OPTILENS_DB_TRUST_CERT','OPTILENS_WRITEBACK_ENABLED') { $v = [Environment]::GetEnvironmentVariable($n,'User'); if ($v) { [Environment]::SetEnvironmentVariable($n,$v,'Process') } }; node server.js"
      ],
      "port": 8080,
      "autoPort": true
    }
  ],
  "autoVerify": true
}
