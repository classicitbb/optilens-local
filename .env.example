OPTILENS_HOST=0.0.0.0
OPTILENS_PORT=8080
OPTILENS_QBO_ENVIRONMENT=sandbox
# Sandbox gateway only; production uses the separate production hostname and store.
OPTILENS_QBO_GATEWAY_URL=https://qbo-sandbox.classicvisions.net
OPTILENS_QBO_HANDOFF_TOKEN=
OPTILENS_DB_SERVER=MSSQL-SVR
OPTILENS_DB_NAME=optilens_local
OPTILENS_DB_USER=optilens_app
OPTILENS_DB_PASSWORD=replace_with_secret
OPTILENS_SOURCE_MSSQL_SERVER=MSSQL-SVR
OPTILENS_SOURCE_MSSQL_DATABASE=Innovations
OPTILENS_SOURCE_MSSQL_USER=sql_reporting
OPTILENS_SOURCE_MSSQL_PASSWORD=replace_with_secret
OPTILENS_SOURCE_MSSQL_ENCRYPT=true
OPTILENS_SOURCE_MSSQL_TRUST_CERT=true
OPTILENS_SOURCE_MSSQL_MODE=read-only
OPTILENS_MIRROR_DB_SERVER=MSSQL-SVR
OPTILENS_MIRROR_DB_NAME=innovations_mirror
OPTILENS_MIRROR_DB_USER=optilens_app
OPTILENS_MIRROR_DB_PASSWORD=replace_with_secret
OPTILENS_MIRROR_SYNC_MINUTES=15
OPTILENS_SUPPLIER_MAILBOX_POLL_TIME=08:10
OPTILENS_MIRROR_INITIAL_ORDER_DAYS=548
OPTILENS_MIRROR_RETENTION_DAYS=92
OPTILENS_SOURCE_PSQL_DSN=Innovations
OPTILENS_SOURCE_PSQL_DRIVER=Pervasive ODBC Interface
OPTILENS_SOURCE_PSQL_HOST=192.168.254.5
OPTILENS_SOURCE_PSQL_PORT=1583
OPTILENS_SOURCE_PSQL_DATABASE=INNOVATIONS
OPTILENS_SOURCE_PSQL_USER=psql
OPTILENS_SOURCE_PSQL_PASSWORD=replace_with_secret
OPTILENS_SOURCE_PSQL_MODE=read-only
# Privileged admin data access. Keep all credentials in Windows secret storage
# or the deployment environment; do not add secrets to this file.
OPTILENS_PRIVILEGED_DATA_ACCESS_ENABLED=false
OPTILENS_PRIVILEGED_DATA_ACCESS_MAX_ROWS=1000
OPTILENS_PRIVILEGED_DATA_ACCESS_TIMEOUT_MS=30000
OPTILENS_ADMIN_SOURCE_MSSQL_WRITE_USER=
OPTILENS_ADMIN_SOURCE_MSSQL_WRITE_PASSWORD=
OPTILENS_ADMIN_SOURCE_PSQL_WRITE_USER=
OPTILENS_ADMIN_SOURCE_PSQL_WRITE_PASSWORD=
OPTILENS_WRITEBACK_ENABLED=false
# After a one-time Status mapping Confirm in Settings, auto-apply high-confidence
# supplier matches. Defaults to false. Still requires OPTILENS_WRITEBACK_ENABLED=true
# and a target CurrentStatusID in OPTILENS_WRITEBACK_STATUS_IDS.
OPTILENS_SUPPLIER_STATUS_AUTO_APPLY=false
# Optional CVWeb integrations. Incidents are always written locally to
# data/host-incidents.jsonl; configured endpoints receive the same JSON payload.
OPTILENS_CVWEB_HELPDESK_URL=
OPTILENS_CVWEB_ALERTS_URL=
OPTILENS_CVWEB_ALERTS_TOKEN=
# Rolling window for the statements / statement_lines push to Classic Visions.
# 5 months is the intended business window. Set to 0 for a full-history backfill.
OPTILENS_STATEMENT_WINDOW_MONTHS=5
# Statements are slower on the cloud receiver because each row resolves the
# customer link and may enqueue statement-ready email. Keep fast entities on
# OPTILENS_SYNC_FETCH_TIMEOUT_MS; give statements a longer single attempt.
OPTILENS_SYNC_STATEMENT_FETCH_TIMEOUT_MS=120000
OPTILENS_SYNC_STATEMENT_FETCH_RETRIES=0
