{
  "name": "optilens-local",
  "version": "0.1.0",
  "private": true,
  "description": "Internal OptiLens Local platform with shared launch page, dashboard, APIs, and delivery/export module shell.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:watch": "node --watch server.js",
    "check": "node --check server.js",
    "test": "node --test test/*.test.js",
    "rx:sync-catalog": "node scripts/sync-rx-catalog.js",
    "rx:verify-catalog": "node scripts/verify-rx-catalog.js",
    "app:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-app.ps1",
    "app:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-app.ps1",
    "app:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-app.ps1",
    "app:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-app-running.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mssql": "^12.5.5",
    "odbc": "^2.5.0"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classicitbb/optilens-local.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/classicitbb/optilens-local/issues"
  },
  "homepage": "https://github.com/classicitbb/optilens-local#readme"
}
