{
  "about": "Synthetic RX Capture dictations (no real patients). Each case is a transcript as the speech model returned it, the extractor proposal, and the fields the voice rules must flag. Add real-staff recordings of made-up prescriptions under test/fixtures/rx-voice-audio/ and run scripts/rx-voice-regression.js before changing the transcription model or prompt.",
  "cases": [
    {
      "name": "clean dictation raises no flags",
      "transcript": "Right eye -2.50 -0.50 axis 180. Left eye -2.25 -0.75 axis 175. Add 2.00, PD 63.",
      "segments": ["right", "left", "measure"],
      "proposal": { "prescription": { "od": { "sphere": "-2.50", "cylinder": "-0.50", "axis": 180, "add": "2.00" }, "os": { "sphere": "-2.25", "cylinder": "-0.75", "axis": 175, "add": "2.00" } }, "pd": { "binocular": 63 } },
      "evidence": [
        { "field": "prescription.od.sphere", "text": "-2.50" },
        { "field": "prescription.od.cylinder", "text": "-0.50" },
        { "field": "prescription.od.axis", "text": "axis 180" },
        { "field": "prescription.od.add", "text": "Add 2.00" },
        { "field": "prescription.os.sphere", "text": "-2.25" },
        { "field": "prescription.os.cylinder", "text": "-0.75" },
        { "field": "prescription.os.axis", "text": "axis 175" },
        { "field": "prescription.os.add", "text": "Add 2.00" },
        { "field": "pd.binocular", "text": "PD 63" }
      ],
      "expectedUncertain": []
    },
    {
      "name": "sign spoken as a word matches the numeric value",
      "transcript": "Right eye minus 2.50 sphere. Left eye plus 0.75 sphere.",
      "segments": ["right", "left"],
      "proposal": { "prescription": { "od": { "sphere": "-2.50" }, "os": { "sphere": "+0.75" } } },
      "evidence": [
        { "field": "prescription.od.sphere", "text": "minus 2.50" },
        { "field": "prescription.os.sphere", "text": "plus 0.75" }
      ],
      "expectedUncertain": []
    },
    {
      "name": "an unsigned sphere is flagged",
      "transcript": "Right eye 2.50 sphere. Left eye -1.00 sphere.",
      "segments": ["right", "left"],
      "proposal": { "prescription": { "od": { "sphere": "2.50" }, "os": { "sphere": "-1.00" } } },
      "evidence": [
        { "field": "prescription.od.sphere", "text": "2.50" },
        { "field": "prescription.os.sphere", "text": "-1.00" }
      ],
      "expectedUncertain": ["prescription.od.sphere"]
    },
    {
      "name": "plano for both eyes needs no sign",
      "transcript": "Both eyes plano.",
      "segments": ["both"],
      "proposal": { "prescription": { "od": { "sphere": "PL" }, "os": { "sphere": "PL" } } },
      "evidence": [
        { "field": "prescription.od.sphere", "text": "plano" },
        { "field": "prescription.os.sphere", "text": "plano" }
      ],
      "expectedUncertain": []
    },
    {
      "name": "a spoken correction leaves the field uncertain",
      "transcript": "Right eye -2.50 no scratch that -2.75 sphere.",
      "segments": ["right"],
      "proposal": { "prescription": { "od": { "sphere": "-2.75" } } },
      "evidence": [
        { "field": "prescription.od.sphere", "text": "-2.50" },
        { "field": "prescription.od.sphere", "text": "-2.75" }
      ],
      "expectedUncertain": ["prescription.od.sphere"]
    },
    {
      "name": "a value the speaker never said is flagged",
      "transcript": "Left eye -1.00 sphere.",
      "segments": ["left"],
      "proposal": { "prescription": { "os": { "sphere": "-1.00", "cylinder": "-0.50" } } },
      "evidence": [
        { "field": "prescription.os.sphere", "text": "-1.00" },
        { "field": "prescription.os.cylinder", "text": "-0.50" }
      ],
      "expectedUncertain": ["prescription.os.cylinder"]
    },
    {
      "name": "job details carry through from their own segments",
      "transcript": "OD -1.00 sphere. OS -1.25 sphere. Lens 1.67 progressive, AR. Frame to follow. Patient Carter. Rush please.",
      "segments": ["right", "left", "lens", "frame", "patient", "instructions"],
      "proposal": { "patient": { "name": "Carter" }, "prescription": { "od": { "sphere": "-1.00" }, "os": { "sphere": "-1.25" } }, "lensRequest": { "lensType": "progressive", "material": "1.67", "coating": "AR" }, "instructions": "Rush" },
      "evidence": [
        { "field": "patient.name", "text": "Carter" },
        { "field": "prescription.od.sphere", "text": "-1.00" },
        { "field": "prescription.os.sphere", "text": "-1.25" },
        { "field": "lensRequest.lensType", "text": "progressive" },
        { "field": "lensRequest.material", "text": "1.67" },
        { "field": "lensRequest.coating", "text": "AR" },
        { "field": "instructions", "text": "Rush please" }
      ],
      "expectedUncertain": []
    }
  ]
}
