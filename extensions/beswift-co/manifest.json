{
  "manifest_version": 3,
  "name": "OptiLens BeSwift CO",
  "version": "0.1.0",
  "description": "Claims OptiLens BeSwift CO jobs and fills the BeSwift certificate form for operator review.",
  "action": {
    "default_title": "OptiLens BeSwift CO",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "debugger", "contextMenus"],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://192.168.254.7:8080/*",
    "https://sso.training.beswift.gov.bb/*",
    "https://training.beswift.gov.bb/*",
    "https://*.training.beswift.gov.bb/*",
    "https://beswift.gov.bb/*",
    "https://*.beswift.gov.bb/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sso.training.beswift.gov.bb/*",
        "https://training.beswift.gov.bb/*",
        "https://*.training.beswift.gov.bb/*",
        "https://beswift.gov.bb/*",
        "https://*.beswift.gov.bb/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
