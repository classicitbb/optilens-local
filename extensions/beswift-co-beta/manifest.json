{
  "manifest_version": 3,
  "key": "",
  "update_url": "http://ino-3frc3q3/extensions/beswift-co-beta-updates.xml",
  "name": "OptiLens BeSwift CO (Beta)",
  "version": "0.4.0",
  "description": "BETA: Claims OptiLens BeSwift CO jobs and fills the BeSwift certificate form for operator review. Adds a rolling on-page progress feed, an attention signal when a run stops for input, an operator-triggered verify-and-submit stage, and operator error/resolution capture for AI refinement. Load side-by-side with the stable extension.",
  "action": {
    "default_title": "OptiLens BeSwift CO (Beta)",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "debugger", "contextMenus", "alarms"],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://192.168.254.7:8080/*",
    "http://192.168.254.7/*",
    "http://ino-3frc3q3/*",
    "http://ino-3frc3q3:8080/*",
    "https://optilens.cv.net/*",
    "https://sso.training.beswift.gov.bb/*",
    "https://training.beswift.gov.bb/*",
    "https://*.training.beswift.gov.bb/*",
    "https://beswift.gov.bb/*",
    "https://*.beswift.gov.bb/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "popup.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sso.training.beswift.gov.bb/*",
        "https://training.beswift.gov.bb/*",
        "https://*.training.beswift.gov.bb/*",
        "https://beswift.gov.bb/*",
        "https://*.beswift.gov.bb/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://optilens.cv.net/*",
        "http://ino-3frc3q3/*",
        "http://ino-3frc3q3:8080/*",
        "http://192.168.254.7/*",
        "http://192.168.254.7:8080/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
