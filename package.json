{
  "name": "optilens-local",
  "version": "0.1.0",
  "private": true,
  "description": "Internal OptiLens Local platform with shared launch page, dashboard, APIs, and delivery/export module shell.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:watch": "node --watch server.js",
    "check": "node --check server.js",
    "test": "node --test test/*.test.js",
    "rx:sync-catalog": "node scripts/sync-rx-catalog.js",
    "rx:verify-catalog": "node scripts/verify-rx-catalog.js",
    "rx:sync-task:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-rx-catalog-sync-task.ps1",
    "innovations:lens-status-sync": "node scripts/sync-actian-lens-status.js",
    "innovations:lens-status-sync:task:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-actian-lens-status-sync-task.ps1",
    "innovations:lens-status-sync": "node scripts/sync-actian-lens-status.js",
    "innovations:lens-status-sync:task:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-actian-lens-status-sync-task.ps1",
    "app:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-app.ps1",
    "app:launch": "powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File scripts/launch-app.ps1",
    "app:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-app.ps1",
    "app:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-app.ps1",
    "app:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-app-running.ps1",
    "app:watchdog:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-app-watchdog-task.ps1",
    "app:watchdog:install:system": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-app-watchdog-task.ps1 -RunAsSystem",
    "app:tray": "powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File scripts/start-monitor.ps1",
    "app:tray:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-host-tray-startup.ps1",
    "app:monitor:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-monitor-exe.ps1",
    "app:monitor:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "codex:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-codex.ps1",
    "codex:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-codex-desktop-shortcut.ps1",
    "app:monitor:harness": "node scripts/monitor-harness.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "imapflow": "^1.6.3",
    "mailparser": "^3.9.14",
    "mssql": "^12.5.5",
    "odbc": "^2.5.0",
    "pdf-parse": "^2.4.5"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classicitbb/optilens-local.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/classicitbb/optilens-local/issues"
  },
  "homepage": "https://github.com/classicitbb/optilens-local#readme"
}
